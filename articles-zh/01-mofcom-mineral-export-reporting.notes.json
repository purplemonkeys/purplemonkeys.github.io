  "breakdowns": [
    {
      "s": 1,
      "meaning": "To make full use of public oversight and crack down on export-control breaches involving dual-use strategic minerals, MOFCOM has decided, under the Export Control Law, the Foreign Trade Law and other laws and regulations, to further improve how it handles reports of such breaches.",
      "chunks": [
        [
          "为充分发挥社会监督作用",
          "in order to make full use of public oversight (为 here = 为了)"
        ],
        [
          "打击……违法违规行为",
          "to crack down on … breaches"
        ],
        [
          "根据《出口管制法》《对外贸易法》等法律法规",
          "under the Export Control Law, the Foreign Trade Law and other laws and regulations"
        ],
        [
          "商务部决定进一步完善……举报处理工作",
          "MOFCOM has decided to further improve how it handles reports of …"
        ]
      ],
      "key": "<b>Purpose first, actor last:</b> notices open with 为… (in order to) and 根据… (under), and only then say who acts. Find <span class='bd-zh-i'>商务部决定</span> and the sentence falls into place."
    },
    {
      "s": 2,
      "meaning": "We hereby announce the following:",
      "chunks": [
        [
          "现",
          "now (formal for 现在)"
        ],
        [
          "公告",
          "announce, as a public notice"
        ],
        [
          "如下",
          "as follows (= 下面这些)"
        ]
      ],
      "key": "<b>Stock phrase:</b> <span class='bd-zh-i'>现公告如下</span> is the fixed line that means \"the rules start here\". Spoken, you'd say 现在宣布下面这些事."
    },
    {
      "s": 3,
      "meaning": "1. Any organisation or individual has the right to report conduct suspected of exporting dual-use strategic minerals in breach of the relevant laws and regulations, including:",
      "chunks": [
        [
          "任何组织和个人",
          "any organisation or individual"
        ],
        [
          "有权举报",
          "has the right to report"
        ],
        [
          "涉嫌违反相关法律法规出口……的行为",
          "conduct suspected of exporting … in breach of the relevant laws (the whole phrase describes 行为)"
        ],
        [
          "包括：",
          "including:"
        ]
      ],
      "key": "<b>Long describer before 的:</b> everything between 举报 and <span class='bd-zh-i'>的行为</span> describes the 行为 (conduct). Find the noun after 的 first, then go back for the description."
    },
    {
      "s": 5,
      "meaning": "(2) exporting dual-use strategic minerals beyond the scope, conditions or validity period stated in the export licence;",
      "chunks": [
        [
          "超出",
          "going beyond"
        ],
        [
          "出口许可证件载明的",
          "stated in the export licence (载明 = 写明)"
        ],
        [
          "范围、条件和有效期",
          "scope, conditions and validity period"
        ],
        [
          "出口战略矿产两用物项",
          "exporting dual-use strategic minerals"
        ]
      ],
      "key": "<b>载 = written in:</b> <span class='bd-zh-i'>载明</span> (zǎimíng) means \"set out in a document\". It's zǎi, not the zài of 载货 (to carry cargo)."
    },
    {
      "s": 7,
      "meaning": "(4) evading licensing when exporting dual-use items related to strategic minerals, for example by modifying them or breaking them down into parts or components;",
      "chunks": [
        [
          "以……等方式",
          "by means such as … (以 = 用, 方式 = 办法)"
        ],
        [
          "改造、拆分为部件或者组件",
          "modifying them, or splitting them into parts or components"
        ],
        [
          "规避许可",
          "evading the licence requirement"
        ],
        [
          "出口战略矿产相关两用物项",
          "to export dual-use items related to strategic minerals"
        ]
      ],
      "key": "<b>The 以…方式 frame:</b> <span class='bd-zh-i'>以 X 等方式 + verb</span> = \"do [verb] by means such as X\". Spoken: 用 X 这些办法来…"
    },
    {
      "s": 9,
      "meaning": "(6) illegally transferring controlled strategic-mineral technology abroad through trade exports or through IP licensing, investment, exchanges, gifts, exhibitions, demonstrations, inspection, testing, aid, teaching, joint R&D, employment, consulting or similar means;",
      "chunks": [
        [
          "通过贸易性出口及……等方式",
          "through trade exports and … similar means (及 = 和)"
        ],
        [
          "知识产权许可、投资、……咨询",
          "the channels: IP licensing, investment, … consulting"
        ],
        [
          "非法对外转移",
          "illegally transferring abroad"
        ],
        [
          "受管制的战略矿产相关技术",
          "controlled technology related to strategic minerals (受管制的 = 被管着的)"
        ]
      ],
      "key": "<b>The list is a catalogue:</b> the 、-separated list just names every channel. Skim it and jump to the verb <span class='bd-zh-i'>非法对外转移</span> to see what is banned."
    },
    {
      "s": 10,
      "meaning": "(7) knowingly providing agency, freight, delivery, customs-declaration, third-party e-commerce platform, financial or similar services to an exporter engaged in unlawful exports of dual-use strategic minerals;",
      "chunks": [
        [
          "明知",
          "knowing full well (that)"
        ],
        [
          "出口经营者从事……出口违法行为",
          "an exporter is engaged in unlawful exports of …"
        ],
        [
          "仍为其提供",
          "still provides them with (仍 = 还是, 为其 = 给他们)"
        ],
        [
          "代理、货运、……金融等服务",
          "agency, freight, … financial and similar services"
        ]
      ],
      "key": "<b>为其 = 给他:</b> <span class='bd-zh-i'>为其提供</span> (wèi qí tígōng) is the formal way to say 给他/他们提供. 其 is the written him/her/it/them."
    }
  ],
